{
  "name": "@life-manager/desktop",
  "version": "0.0.1",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build-backend": "node scripts/build-backend.mjs",
    "copy-frontend": "node scripts/copy-frontend.mjs",
    "prepare:resources": "npm run build-backend && npm run copy-frontend",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild-native",
    "start": "npm run prepare:resources && electron .",
    "dist": "npm run prepare:resources && electron-builder --win"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^11.5.0",
    "chokidar": "^5.0.0",
    "csv-parse": "^7.0.1",
    "drizzle-orm": "^0.36.1",
    "fastify": "^5.1.0",
    "fuse.js": "^7.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "rimraf": "^6.0.1"
  }
}
